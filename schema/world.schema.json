{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expert-quest.local/schema/world.schema.json",
  "title": "Expert Quest world file",
  "description": "World file format defined in framework chapter 8 (expert-quest/1.3). Section numbers in descriptions refer to framework/expert-quest-framework.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["framework", "id", "title", "lang", "source", "license", "schools", "clusters", "skills", "practices", "placement", "bosses", "achievements", "glossary", "report"],
  "properties": {
    "framework": { "description": "Later versions only add fields and values, so older worlds stay valid.", "enum": ["expert-quest/1.0", "expert-quest/1.1", "expert-quest/1.2", "expert-quest/1.3"] },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "license"],
      "properties": {
        "type": { "enum": ["textbook", "paper", "review"] },
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "string" },
        "edition": { "type": "string" },
        "year": { "type": "integer" },
        "license": { "$ref": "#/$defs/license" },
        "pageOffset": { "description": "7.1: PDF page = printed page + pageOffset.", "type": "integer" }
      }
    },
    "license": {
      "description": "7.4: default license for structure and supplement content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": { "default": { "$ref": "#/$defs/license" } }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string" },
        "goal": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "metaphor": { "type": "string" } }
    },
    "schools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/school" } },
    "clusters": { "type": "array", "items": { "$ref": "#/$defs/cluster" } },
    "skills": { "description": "May be empty while a world is in progress (8.7); check-world requires one when complete.", "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "practices": { "type": "array", "items": { "$ref": "#/$defs/practice" } },
    "placement": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "bosses": { "type": "array", "items": { "$ref": "#/$defs/boss" } },
    "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
    "glossary": { "type": "array", "items": { "$ref": "#/$defs/glossaryEntry" } },
    "bridges": { "type": "array", "items": { "$ref": "#/$defs/bridge" } },
    "sources": {
      "description": "8.1, 8.6: sources used by P6 expansions.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "license"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "license": { "$ref": "#/$defs/license" }
        }
      }
    },
    "report": { "$ref": "#/$defs/report" },
    "share": {
      "description": "7.4: added by the game to a class (share) version; never written by the AI.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "class" },
        "exportedAt": { "type": "string" },
        "credits": { "type": "array" },
        "nonCommercial": { "type": "boolean" },
        "removed": { "type": "object" }
      }
    }
  },

  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "localId": {
      "description": "ID that only needs to be unique within this world (clusters, practices, bosses, ...).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "discipline": { "enum": ["math", "physics", "chemistry", "biology"] },
    "schoolId": {
      "description": "5.1: <discipline>/<school>, preferably from Appendix A.",
      "type": "string",
      "pattern": "^(math|physics|chemistry|biology)/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "skillId": {
      "description": "5.6: <discipline>/<skill>.",
      "type": "string",
      "pattern": "^(math|physics|chemistry|biology)/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
    "level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "pageRange": {
      "type": "array",
      "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
      "minItems": 2,
      "maxItems": 2
    },
    "expr": {
      "description": "7.2: expression evaluated by the engine. Not LaTeX.",
      "type": "string",
      "minLength": 1
    },
    "num": {
      "description": "A literal number or an expression over the question vars.",
      "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/expr" }]
    },
    "vars": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "number" }
    },

    "license": {
      "description": "7.4: SPDX identifier, LicenseRef-*, or NOASSERTION.",
      "type": "string",
      "pattern": "^(NOASSERTION|LicenseRef-[A-Za-z0-9.-]+|[A-Za-z0-9][A-Za-z0-9.+-]*)$"
    },
    "origin": { "description": "7.1: concept-based content uses the document's ideas only and follows license.default.", "enum": ["document", "concept-based", "supplement", "expansion"] },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "loc": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "marking": {
      "description": "7.1: every content item carries origin, license and attribution.",
      "type": "object",
      "required": ["origin", "license", "attribution"],
      "properties": {
        "origin": { "$ref": "#/$defs/origin" },
        "license": { "$ref": "#/$defs/license" },
        "attribution": { "$ref": "#/$defs/attribution" }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "expansion" } } },
          "then": { "properties": { "attribution": { "required": ["name", "url"] } } }
        },
        {
          "if": { "properties": { "origin": { "const": "supplement" } } },
          "then": { "properties": { "attribution": { "required": ["name"] } } }
        },
        {
          "if": { "properties": { "origin": { "const": "concept-based" } } },
          "then": { "properties": { "attribution": { "required": ["loc"] } } }
        }
      ]
    },
    "text": {
      "description": "7.1: plain text, or an object overriding the parent item's marking.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "origin", "license", "attribution"],
          "properties": {
            "text": { "type": "string" },
            "origin": { "$ref": "#/$defs/origin" },
            "license": { "$ref": "#/$defs/license" },
            "attribution": { "$ref": "#/$defs/attribution" }
          }
        }
      ]
    },
    "confidence": { "description": "7.3: stored as code; the UI shows 文件原意 / AI 驗證 / 探索中.", "enum": ["document", "ai-verified", "exploratory"] },

    "school": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "discipline", "tiers"],
      "properties": {
        "id": { "$ref": "#/$defs/schoolId" },
        "name": { "type": "string", "minLength": 1 },
        "en": { "type": "string" },
        "discipline": { "$ref": "#/$defs/discipline" },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier", "name"],
            "properties": {
              "tier": { "$ref": "#/$defs/tier" },
              "name": { "type": "string" },
              "label": { "type": "string" },
              "anchor": { "type": "string" },
              "boss": { "$ref": "#/$defs/localId" }
            }
          }
        },
        "finalBoss": { "$ref": "#/$defs/localId" }
      }
    },

    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "school", "tier", "name", "skills"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "school": { "$ref": "#/$defs/schoolId" },
        "tier": { "$ref": "#/$defs/tier" },
        "name": { "type": "string", "minLength": 1 },
        "en": { "type": "string" },
        "pages": { "$ref": "#/$defs/pageRange" },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skillId" } },
        "boss": { "$ref": "#/$defs/localId" }
      }
    },

    "skill": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/marking" }],
      "unevaluatedProperties": false,
      "required": ["id", "name", "schools", "tier", "kind", "ktype", "maxLevel", "pre", "def", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/skillId" },
        "name": { "type": "string", "minLength": 1 },
        "en": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "num": { "type": "string" },
        "schools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/schoolId" } },
        "tier": { "$ref": "#/$defs/tier" },
        "cluster": { "$ref": "#/$defs/localId" },
        "kind": { "enum": ["core", "optional", "app", "tool", "supplement"] },
        "ktype": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["fact", "concept", "procedure", "principle", "judgment"] }
        },
        "maxLevel": { "$ref": "#/$defs/level" },
        "meta": { "type": "array", "items": { "type": "string" } },
        "pre": { "type": "array", "items": { "$ref": "#/$defs/skillId" } },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill", "unlocks"],
            "properties": {
              "skill": { "$ref": "#/$defs/skillId" },
              "unlocks": { "$ref": "#/$defs/level" }
            }
          }
        },
        "pages": { "$ref": "#/$defs/pageRange" },
        "examples": { "type": "array", "items": { "type": "string" } },
        "practiceRefs": { "type": "array", "items": { "type": "string" } },
        "def": { "$ref": "#/$defs/text" },
        "analog": { "$ref": "#/$defs/text" },
        "analogLimit": { "$ref": "#/$defs/text" },
        "story": { "$ref": "#/$defs/text" },
        "figs": { "type": "array", "items": { "$ref": "#/$defs/fig" } },
        "terms": { "type": "array", "items": { "type": "string" } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "expandable": { "type": "boolean" }
      }
    },

    "practice": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/marking" },
        {
          "description": "6.3: encounter questions must be auto-gradable.",
          "if": { "properties": { "encounter": { "const": true } }, "required": ["encounter"] },
          "then": { "properties": { "question": { "properties": { "type": { "enum": ["mc", "numeric", "order"] } } } } }
        }
      ],
      "unevaluatedProperties": false,
      "required": ["id", "skill", "level", "context", "question"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "skill": { "$ref": "#/$defs/skillId" },
        "level": { "$ref": "#/$defs/level" },
        "context": { "enum": ["subject", "commission"] },
        "scene": { "type": "string" },
        "encounter": { "type": "boolean" },
        "question": { "$ref": "#/$defs/question" }
      }
    },

    "placement": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/marking" }],
      "unevaluatedProperties": false,
      "required": ["id", "school", "tier", "skills", "question"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "school": { "$ref": "#/$defs/schoolId" },
        "tier": { "$ref": "#/$defs/tier" },
        "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skillId" } },
        "question": {
          "allOf": [
            { "$ref": "#/$defs/question" },
            { "properties": { "type": { "enum": ["mc", "numeric"] } } }
          ]
        }
      }
    },

    "boss": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/marking" }],
      "unevaluatedProperties": false,
      "required": ["id", "kind", "name", "skills", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "enum": ["gym", "tier", "final"] },
        "name": { "type": "string", "minLength": 1 },
        "npc": { "type": "string" },
        "intro": { "$ref": "#/$defs/text" },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skillId" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    },

    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "name", "when"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "rank": { "enum": ["bronze", "silver", "gold", "platinum", "final"] },
        "name": { "type": "string", "minLength": 1 },
        "desc": { "type": "string" },
        "when": {
          "description": "3.4: condition. Combine fields as needed, e.g. {boss}, {skill, level}, {bridge}, {discipline, count}.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "boss": { "$ref": "#/$defs/localId" },
            "skill": { "$ref": "#/$defs/skillId" },
            "level": { "$ref": "#/$defs/level" },
            "bridge": { "type": "string" },
            "discipline": { "$ref": "#/$defs/discipline" },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },

    "glossaryEntry": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/marking" }],
      "unevaluatedProperties": false,
      "required": ["term", "def"],
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "en": { "type": "string" },
        "def": { "$ref": "#/$defs/text" },
        "skill": { "$ref": "#/$defs/skillId" }
      }
    },

    "bridge": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/marking" }],
      "unevaluatedProperties": false,
      "required": ["a", "b", "meta", "steps"],
      "properties": {
        "a": { "$ref": "#/$defs/skillId" },
        "b": { "$ref": "#/$defs/skillId" },
        "meta": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    },

    "report": {
      "description": "8.9",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stats": { "type": "object" },
        "mapping": { "type": "array" },
        "gaps": { "type": "array" },
        "expandable": { "type": "array" },
        "possibleDuplicates": { "type": "array" },
        "missingPrereqs": { "type": "array" },
        "possibleBridges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill"],
            "properties": {
              "skill": { "$ref": "#/$defs/skillId" },
              "meta": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "newSchools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "$ref": "#/$defs/schoolId" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "licenses": { "type": "object" }
      }
    },

    "question": {
      "description": "8.2",
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["mc", "numeric", "order", "sim", "method"] } },
      "oneOf": [
        { "$ref": "#/$defs/qMc" },
        { "$ref": "#/$defs/qNumeric" },
        { "$ref": "#/$defs/qOrder" },
        { "$ref": "#/$defs/qSim" },
        { "$ref": "#/$defs/qMethod" }
      ]
    },
    "qCommon": {
      "properties": {
        "q": { "type": "string", "minLength": 1 },
        "ex": { "type": "string" },
        "fig": { "$ref": "#/$defs/fig" },
        "verified": { "enum": ["engine-only"] }
      }
    },
    "qMc": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/qCommon" }],
      "unevaluatedProperties": false,
      "required": ["type", "q", "opts", "a"],
      "properties": {
        "type": { "const": "mc" },
        "opts": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "a": { "type": "integer", "minimum": 0 },
        "why": { "type": "array", "items": { "type": ["string", "null"] } }
      }
    },
    "qNumeric": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/qCommon" },
        {
          "description": "as: mc needs mistakes as the other options. Kept inside allOf: a top-level conditional breaks unevaluatedProperties in some validators.",
          "if": { "required": ["as"] },
          "then": { "required": ["mistakes"], "properties": { "mistakes": { "minItems": 1 } } }
        }
      ],
      "unevaluatedProperties": false,
      "required": ["type", "q", "vars", "answer"],
      "properties": {
        "type": { "const": "numeric" },
        "as": { "const": "mc" },
        "vars": { "$ref": "#/$defs/vars" },
        "answer": { "$ref": "#/$defs/expr" },
        "unit": { "type": "string" },
        "sig": { "type": "integer", "minimum": 1 },
        "mistakes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expr", "why"],
            "properties": {
              "expr": { "$ref": "#/$defs/expr" },
              "why": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "qOrder": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/qCommon" }],
      "unevaluatedProperties": false,
      "required": ["type", "q", "items"],
      "properties": {
        "type": { "const": "order" },
        "items": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "shown": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "qSim": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/qCommon" }],
      "unevaluatedProperties": false,
      "required": ["type", "q", "sliders", "output", "pass"],
      "properties": {
        "type": { "const": "sim" },
        "sliders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["var", "min", "max", "step"],
            "properties": {
              "var": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "label": { "type": "string" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "type": "string" }
            }
          }
        },
        "consts": { "$ref": "#/$defs/vars" },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "expr"],
          "properties": {
            "label": { "type": "string" },
            "expr": { "$ref": "#/$defs/expr" },
            "unit": { "type": "string" }
          }
        },
        "pass": { "$ref": "#/$defs/expr" }
      }
    },
    "qMethod": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/qCommon" }],
      "unevaluatedProperties": false,
      "required": ["type", "q", "methods", "then"],
      "properties": {
        "type": { "const": "method" },
        "methods": {
          "type": "array",
          "minItems": 2,
          "contains": { "type": "object", "required": ["best"], "properties": { "best": { "const": true } } },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "best": { "type": "boolean" },
              "why": { "type": "string" }
            }
          }
        },
        "then": { "$ref": "#/$defs/question" }
      }
    },

    "fig": {
      "description": "8.4: seven figure data formats.",
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["plot", "diagram", "circuit", "molecule", "flow", "table", "ref"] } },
      "oneOf": [
        { "$ref": "#/$defs/figPlot" },
        { "$ref": "#/$defs/figDiagram" },
        { "$ref": "#/$defs/figCircuit" },
        { "$ref": "#/$defs/figMolecule" },
        { "$ref": "#/$defs/figFlow" },
        { "$ref": "#/$defs/figTable" },
        { "$ref": "#/$defs/figRef" }
      ]
    },
    "point": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/num" }, { "$ref": "#/$defs/num" }],
      "minItems": 2,
      "maxItems": 2
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "var": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "log": { "type": "boolean" }
      }
    },
    "figPlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "series"],
      "properties": {
        "type": { "const": "plot" },
        "x": { "allOf": [{ "$ref": "#/$defs/axis" }], "required": ["min", "max"] },
        "y": { "$ref": "#/$defs/axis" },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expr": { "$ref": "#/$defs/expr" },
              "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
              "label": { "type": "string" },
              "style": { "enum": ["line", "dots"] }
            },
            "oneOf": [{ "required": ["expr"] }, { "required": ["points"] }]
          }
        }
      }
    },
    "figDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "grid"],
      "properties": {
        "type": { "const": "diagram" },
        "grid": { "$ref": "#/$defs/gridSize" },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "at"],
            "properties": { "id": { "type": "string" }, "at": { "$ref": "#/$defs/point" } }
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "style": { "enum": ["solid", "dashed"] }
            }
          }
        },
        "arrows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/point" },
              "to": { "$ref": "#/$defs/point" },
              "label": { "type": "string" }
            }
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "text"],
            "properties": { "at": { "$ref": "#/$defs/point" }, "text": { "type": "string" } }
          }
        }
      }
    },
    "gridSize": {
      "type": "array",
      "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
      "minItems": 2,
      "maxItems": 2
    },
    "figCircuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "grid", "elements"],
      "properties": {
        "type": { "const": "circuit" },
        "grid": { "$ref": "#/$defs/gridSize" },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": { "type": "string" },
              "kind": {
                "enum": ["wire", "resistor", "capacitor", "inductor", "vsource", "isource", "dep-vsource", "dep-isource",
                         "ground", "switch", "diode", "lamp", "ammeter", "voltmeter", "opamp"]
              },
              "from": { "$ref": "#/$defs/point" },
              "to": { "$ref": "#/$defs/point" },
              "pins": {
                "type": "object",
                "additionalProperties": false,
                "required": ["plus", "minus", "out"],
                "properties": {
                  "plus": { "$ref": "#/$defs/point" },
                  "minus": { "$ref": "#/$defs/point" },
                  "out": { "$ref": "#/$defs/point" }
                }
              },
              "label": { "type": "string" }
            },
            "if": { "properties": { "kind": { "const": "opamp" } } },
            "then": { "required": ["pins"] },
            "else": { "required": ["from", "to"] }
          }
        }
      }
    },
    "figMolecule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "smiles"],
      "properties": {
        "type": { "const": "molecule" },
        "smiles": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      }
    },
    "figFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodes", "edges"],
      "properties": {
        "type": { "const": "flow" },
        "dir": { "enum": ["LR", "TB"] },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "figTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cols", "rows"],
      "properties": {
        "type": { "const": "table" },
        "cols": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["expr"],
                  "properties": { "expr": { "$ref": "#/$defs/expr" } }
                }
              ]
            }
          }
        }
      }
    },
    "figRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "desc"],
      "properties": {
        "type": { "const": "ref" },
        "desc": { "type": "string", "minLength": 1 },
        "page": { "type": "integer" },
        "figure": { "type": "string" }
      }
    }
  }
}
